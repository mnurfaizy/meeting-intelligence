# Copy this file to .env.local and fill in your keys.

# Transcription (speaker labels + language detection).
# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Meeting summary and title.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model used for the summary.
GEMINI_MODEL=gemini-2.5-flash

# Assistant chat. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b (Groq's flagship production model).
GROQ_MODEL=
# Optional: transcript/context tokens sent per question (default 3500, sized for the
# free plan's 8K tokens per minute). Raise it on a paid plan to send whole transcripts.
GROQ_MAX_INPUT_TOKENS=

# Database for meetings, transcripts, summaries and chats (Turso / libSQL).
# Leave empty to use a local SQLite file (local.db) during development.
# Create one at https://turso.tech, then copy its URL (libsql://...) and an auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: folder where recordings are saved as plain audio files.
# Defaults to ./recordings. Point it at a Google Drive for Desktop folder to back recordings up.
# AUDIO_DIR=G:\My Drive\Meeting Recordings
AUDIO_DIR=

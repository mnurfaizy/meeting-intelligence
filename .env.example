# Copy this file to .env.local and fill in your keys.

# Transcription (speaker labels + language detection).
# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Summary and Assistant chat.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model used for the summary and chat.
GEMINI_MODEL=gemini-2.5-flash
